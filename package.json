{
  "name": "cuex-monorepo",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "demo": "node scripts/demo.mjs",
    "dev:web": "pnpm --filter @cuex/web dev",
    "dev:server": "pnpm --filter @cuex/server dev",
    "build": "pnpm --filter @cuex/web build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "check:public-data": "node scripts/check-public-data.mjs",
    "check:legacy": "node scripts/check-legacy-domain.mjs",
    "db:backup": "node scripts/db-backup-restore.mjs",
    "ppt:dev": "npm --prefix ppt run dev",
    "ppt:build": "npm --prefix ppt run build",
    "ppt:preview": "npm --prefix ppt run preview",
    "ppt:export:final": "npm --prefix ppt run export:final"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "^18.3.12",
      "@types/react-dom": "^18.3.1"
    }
  },
  "packageManager": "pnpm@9.15.9",
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
