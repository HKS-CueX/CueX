# Default: runnable local runtime using deterministic local rules; zero paid API keys required.
# Start server directly:
# pnpm --filter @cuex/server exec node --env-file=../../.env --import tsx src/index.ts
HOST=127.0.0.1
PORT=8765
CUEX_SYSTEM1=fake
CUEX_SYSTEM2=fake
CUEX_ASR=fake
CUEX_TTS=fake

# Persistent data directories (default: ../../.cuex-runtime/* relative to apps/server)
# CUEX_RUNTIME_DIR=/absolute/path/to/.cuex-runtime
# CUEX_MEMORY_DIR=/absolute/path/to/memory
# CUEX_PACKS_DIR=/absolute/path/to/packs

# System 1 (fast real-time classifier via llama-server-compatible endpoint, e.g. JEV-9B):
# Set CUEX_SYSTEM1=real and configure CUEX_S1_URL; falls back cleanly to local deterministic rules on error or missing URL.
# CUEX_S1_URL=http://127.0.0.1:18080
# CUEX_S1_FORMAT=jev-v1
# CUEX_S1_TIMEOUT_MS=1460

# System 2 (slow grounded candidate synthesizer via pi-ai):
# Set CUEX_SYSTEM2=real and configure provider credentials; never invents facts absent from verified Evidence.
# CUEX_S2_PROVIDER=cuex-provider
# CUEX_S2_BASE_URL=https://your-provider.example/v1
# CUEX_S2_MODEL=your-model-id
# CUEX_S2_API_KEY=replace-with-your-private-key
# CUEX_S2_TIMEOUT_MS=10000
# PRIME_MODELS_JSON=/absolute/path/to/models.json

# Speech Recognition (ASR):
# Set CUEX_ASR=real and install local sherpa-onnx model (apps/server/scripts/voice-fetch-asr-model.sh)
# or point CUEX_ASR_URL to a streaming sherpa-onnx WebSocket service.
# Browser Web Speech API and manual text simulation work over WebSocket `speech.delta` even without native ASR.
# CUEX_MODEL_DIR=/absolute/path/to/model-cache
# CUEX_ASR_MODEL_DIR=/absolute/path/to/extracted-asr-model
# CUEX_ASR_URL=ws://127.0.0.1:6006

# Controller tuning (optional overrides):
# CUEX_COOLDOWN_MS=15000
# CUEX_CANDIDATE_TTL_MS=12000
# CUEX_DISMISS_SUPPRESSION_MS=45000
# CUEX_UTILITY_LAMBDA=2
