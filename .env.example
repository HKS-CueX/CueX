# Default: runnable local runtime using deterministic local rules & built-in node:sqlite storage; zero paid API keys required.
# Start server directly:
# pnpm --filter @cuex/server exec node --env-file=../../.env --import tsx src/index.ts
CUEX_ENV=development
HOST=127.0.0.1
PORT=8765
CUEX_SYSTEM1=fake
CUEX_SYSTEM2=fake
CUEX_ASR=fake

# Persistent storage (default: ../../.cuex-runtime/cuex.db relative to apps/server)
# CUEX_RUNTIME_DIR=/path/to/.cuex-runtime
# CUEX_SQLITE_PATH=/path/to/.cuex-runtime/cuex.db
# CUEX_MEMORY_DIR=/path/to/legacy-memory-import
# CUEX_PACKS_DIR=/path/to/legacy-packs-import
# CUEX_RETENTION_DAYS=90

# Auth, CORS, Rate Limit & Upload Bounds
CUEX_AUTH_REQUIRED=true
# CUEX_AUTH_TOKEN_TTL_HOURS=24
# CUEX_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# CUEX_RATE_LIMIT_RPM=120
# CUEX_MAX_UPLOAD_MB=15

# Billing / Webhook verification (unconfigured by default -> sandbox checkout preview only)
# CUEX_WEBHOOK_SECRET=replace-with-your-hmac-secret

# System 1 (real-time calibrated fast decision classifier, Colab / local JEV-27B or JEV-9B):
# Set CUEX_SYSTEM1=real and configure CUEX_S1_URL; falls back safely with degraded attribution if unavailable.
# CUEX_S1_URL=https://your-s1-endpoint.example:10010
# CUEX_S1_API_KEY=replace-with-your-s1-bearer-token
# CUEX_S1_MODEL=autotrust/JEV-27B
# CUEX_S1_FORMAT=jev-v1
# CUEX_S1_PROMPT_FORMAT=jev-v1
# CUEX_S1_TIMEOUT_MS=1460
# CUEX_S1_CA_CERT=/path/to/ca-cert.pem

# System 2 / Compiler / Reflection (CPA endpoint or compatible OpenAI Responses / Chat API):
# Set CUEX_SYSTEM2=real and configure CPA_BASE_URL / CPA_API_KEY (or CUEX_CPA_* aliases); never fabricates facts absent from verified Evidence.
# CPA_BASE_URL=https://your-cpa-endpoint.example/v1
# CPA_API_KEY=replace-with-your-cpa-api-key
# CPA_API_MODE=responses
# CPA_SYSTEM2_MODEL=gemini-4-hydrogen
# CPA_COMPILER_MODEL=gemini-4-hydrogen
# CPA_REFLECTION_MODEL=gemini-4-hydrogen
# CPA_SYSTEM2_REASONING_EFFORT=medium
# CPA_TIMEOUT_MS=25000
# Alternative explicit aliases (optional):
# CUEX_CPA_BASE_URL=https://your-cpa-endpoint.example/v1
# CUEX_CPA_API_KEY=replace-with-your-cpa-api-key
# CUEX_CPA_SYSTEM2_MODEL=gemini-4-hydrogen
# CUEX_CPA_REASONING_EFFORT=medium

# Speech Recognition (ASR):
# Set CUEX_ASR=real and configure Colab streaming SenseVoiceSmall ASR (CUEX_COLAB_ASR_*)
# or point CUEX_ASR_URL / local sherpa-onnx model (apps/server/scripts/voice-fetch-asr-model.sh).
# Browser Web Speech API and manual text simulation work over WebSocket `speech.delta` even without native ASR.
# CUEX_COLAB_ASR_URL=https://your-asr-endpoint.example:10086
# CUEX_COLAB_ASR_WS_URL=wss://your-asr-endpoint.example:10086/ws/asr
# CUEX_COLAB_ASR_API_KEY=replace-with-your-asr-bearer-token
# CUEX_COLAB_ASR_CA_CERT=/path/to/ca-cert.pem
# CUEX_COLAB_ASR_LANGUAGE=auto
# CUEX_MODEL_DIR=/path/to/model-cache
# CUEX_ASR_MODEL_DIR=/path/to/extracted-asr-model
# CUEX_ASR_URL=ws://127.0.0.1:6006

# Controller tuning (optional overrides):
# CUEX_COOLDOWN_MS=15000
# CUEX_CANDIDATE_TTL_MS=12000
# CUEX_DISMISS_SUPPRESSION_MS=45000
# CUEX_UTILITY_LAMBDA=2
