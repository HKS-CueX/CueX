# CueX Phase 3 Colab GPU ASR Configuration Template
# Copy runtime values into gitignored `.cuex-runtime/.env.phase3.local` on your local machine
# and inject COLAB_ASR_API_KEY only into the Colab runtime environment.
# NEVER commit real API keys, FRP auth tokens, private keys, or public host IPs.

# --- Colab VM ASR Server ---
COLAB_ASR_HOST=127.0.0.1
COLAB_ASR_PORT=10086
COLAB_ASR_MODEL=FunAudioLLM/SenseVoiceSmall
COLAB_ASR_HUB=hf
COLAB_ASR_DEVICE=cuda:0
COLAB_ASR_API_KEY=replace-with-32-byte-random-hex-secret

# Ephemeral self-signed TLS settings (generated on Colab startup if files do not exist)
COLAB_ASR_TLS_DIR=/tmp/cuex-asr-tls
COLAB_ASR_TLS_CERT=/tmp/cuex-asr-tls/cert.pem
COLAB_ASR_TLS_KEY=/tmp/cuex-asr-tls/key.pem
# Comma-separated IPs added to TLS SubjectAltName (use RFC 5737 placeholder here; set actual FRP host locally)
COLAB_ASR_TLS_SAN_IPS=127.0.0.1,203.0.113.10
COLAB_ASR_TLS_SAN_DNS=localhost

# Guardrails & Streaming Tuning
COLAB_ASR_MAX_UPLOAD_BYTES=15728640
COLAB_ASR_MAX_AUDIO_SEC=180
COLAB_ASR_INFER_TIMEOUT_SEC=30
COLAB_ASR_PARTIAL_INTERVAL_MS=450
COLAB_ASR_ENDPOINT_SILENCE_MS=650
COLAB_ASR_MAX_UTTERANCE_SEC=20

# --- CueX Local Server -> Colab ASR Client (store real values in .cuex-runtime/.env.phase3.local) ---
CUEX_ASR=real
CUEX_COLAB_ASR_URL=https://203.0.113.10:10086
CUEX_COLAB_ASR_WS_URL=wss://203.0.113.10:10086/v1/asr/stream
CUEX_COLAB_ASR_API_KEY=replace-with-32-byte-random-hex-secret
CUEX_COLAB_ASR_CA_CERT=.cuex-runtime/colab-asr-cert.pem
CUEX_COLAB_ASR_TIMEOUT_MS=8000
